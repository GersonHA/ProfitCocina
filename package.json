{
  "name": "profit-cocina",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma colaborativa de producción y cocina para Albion Online: registra datos reales (procesos por lote, Kardex valorizado, compras entre miembros y ventas) y compara modelos de precio para medir la justicia del acuerdo.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:seed": "node scripts/seed-local.mjs",
    "items:download": "node scripts/download-items.mjs",
    "fn:serve": "supabase functions serve"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "supabase": "^3.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0"
  }
